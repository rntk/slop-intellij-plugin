# syntax=docker/dockerfile:1.7
# Generated for project: app, agent: codex-cli
# Strategy: A (FROM shared base .code_agents/Dockerfile.code_agent, which
# reproduces the project Dockerfile's eclipse-temurin:21-jdk-jammy environment)
# Base image: app-code-agent:latest (override with --build-arg BASE_IMAGE=...)
# Tech stack: Java 21 / Kotlin, Gradle wrapper (cached in /app/.gradle/agent-home);
#   Node.js added here (checksum-verified official tarball) because Codex CLI is an npm package.
# Required env vars (set at runtime, NOT in image): OPENAI_API_KEY (optional if already logged in)
#
# Build (from project root):
#   docker build --no-cache --build-arg BASE_IMAGE="app-code-agent:latest" \
#     -f .code_agents/Dockerfile.codex-cli -t "$(basename $(pwd))-codex-cli:latest" .
# Run (via helper):
#   ./.code_agents/agent.sh run
# Run (manual):
#   export OPENAI_API_KEY="YOUR_API_KEY"
#   docker run --rm -it -v $(pwd):/app -v $HOME/.codex:/home/appuser/.codex \
#     -e OPENAI_API_KEY=$OPENAI_API_KEY app-codex-cli:latest -a never --sandbox danger-full-access
#   # If already logged in, omit the API key:
#   docker run --rm -it -v $(pwd):/app -v $HOME/.codex:/home/appuser/.codex \
#     app-codex-cli:latest -a never --sandbox danger-full-access
#   # Or authenticate via device flow:
#   docker run --rm -it -v $(pwd):/app -v $HOME/.codex:/home/appuser/.codex \
#     app-codex-cli:latest login --device-auth --sandbox danger-full-access
#
# Notes:
# - Runs as non-root appuser (UID 1000); config persists in host ~/.codex
#   (reference path /home/node/.codex adapted to this image's appuser home).

ARG BASE_IMAGE=app-code-agent:latest
FROM ${BASE_IMAGE}

ARG TARGETARCH
ARG NODE_VERSION=24.11.0
ARG CODEX_VERSION=latest

ENV NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false

# Install Node.js from the official tarball with SHA256 verification
USER root
RUN case "$TARGETARCH" in \
      amd64) NARCH='x64' ;; \
      arm64) NARCH='arm64' ;; \
      *) echo "Unsupported: $TARGETARCH" && exit 1 ;; \
    esac \
 && cd /tmp \
 && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NARCH}.tar.xz" \
 && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" \
 && grep " node-v${NODE_VERSION}-linux-${NARCH}.tar.xz\$" SHASUMS256.txt | sha256sum -c - \
 && tar -xJf "node-v${NODE_VERSION}-linux-${NARCH}.tar.xz" -C /usr/local --strip-components=1 --no-same-owner \
 && rm -f /tmp/node-v* /tmp/SHASUMS256.txt \
 && node --version && npm --version

# User-writable npm global prefix
RUN mkdir -p /home/appuser/.npm-global && chown -R appuser:appuser /home/appuser/.npm-global
ENV NPM_CONFIG_PREFIX=/home/appuser/.npm-global
ENV PATH="/home/appuser/.npm-global/bin:${PATH}"

USER appuser
WORKDIR /app

# Install Codex CLI globally with BuildKit cache
RUN --mount=type=cache,uid=1000,gid=1000,target=/home/appuser/.npm \
    npm install -g "@openai/codex@${CODEX_VERSION}" \
 && npm cache clean --force

ENTRYPOINT ["codex"]
