# Generated for project: app
# Strategy: A (extends project Dockerfile: eclipse-temurin:21-jdk-jammy development stage)
# Tech stack: Java 21 / Kotlin (JVM toolchain 21), Gradle wrapper, IntelliJ Platform plugin
# (org.jetbrains.intellij.platform 2.10.5, IntelliJ IDEA Ultimate 2025.2.4)
# Test/quality tools: JUnit 4, ./build.sh check (test buildPlugin verifyPluginStructure)
#
# Shared base image for AI coding agents. Contains system packages and the JDK;
# Gradle, dependencies, and the IntelliJ SDK are cached in the bind-mounted project.
# This image sets NO entrypoint; each agent Dockerfile sets its own.
#
# Build (from project root, build context must stay the project root):
#   docker build -f .code_agents/Dockerfile.code_agent -t "$(basename $(pwd))-code-agent:latest" .

FROM eclipse-temurin:21-jdk-jammy

# System packages: project needs (fontconfig, libfreetype6 for Java2D/Swing
# headless builds/tests) + agent needs (git, curl, ripgrep, iputils-ping).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        fontconfig \
        libfreetype6 \
        git \
        curl \
        ripgrep \
        iputils-ping \
        ca-certificates \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Non-root user required by agent images (project base image has none).
RUN useradd -m -u 1000 -s /bin/bash appuser

# The project is bind-mounted at /app, so a Gradle home inside it survives
# container restarts and is shared by every agent image: the IntelliJ IDEA SDK
# (about 1.4 GB download, several GB unpacked) is fetched once, not on every
# start. Agents should prefer ./build.sh (see AGENTS.md), which uses the same
# directory and also isolates the project cache and serializes builds.
ENV GRADLE_USER_HOME=/app/.gradle/agent-home

WORKDIR /app
RUN chown -R appuser:appuser /app /home/appuser

USER appuser
