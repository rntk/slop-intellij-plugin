<idea-plugin>
    <id>dev.insight.workbench</id>
    <name>Insight Workbench</name>
    <vendor>Insight Workbench</vendor>
    <description><![CDATA[
        A Kotlin workbench with a project chat sidebar and an editor-area visualization dashboard.
        The chat answers with a llama.cpp (or other OpenAI-compatible) server configured in Settings → Tools → Insight Chat,
        using read-only tools to list, search, and read project files; without a server it uses local demo responses.
        The dashboard shows explicitly labeled sample data.
        <br/>Application Graph shows Java, Kotlin, Python, Go, JavaScript and TypeScript project symbols and relationships, highlighting the active file.
        <br/>Entry Points (an Application Graph tab) compares application entry points found with the LLM API and Decisions API.
        <br/>Show Call Graph (editor context menu, Tools menu) draws the callers and callees of a function in any of those languages.
        <br/>Code Review (Tools menu, or Review Code in Directory in the Project view) reviews the code in the project, a folder, or an entry file and the files it depends on, with a chat, summaries from the whole scope down to each file, and topics.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <!-- Language support for the call graph is optional, so the plugin loads in any IDE and covers whichever languages it has. -->
    <depends optional="true" config-file="call-graph-java.xml">com.intellij.java</depends>
    <depends optional="true" config-file="call-graph-kotlin.xml">org.jetbrains.kotlin</depends>
    <!-- PyCharm (Community/Professional) and the Python plugins all provide the python module. -->
    <depends optional="true" config-file="call-graph-python.xml">com.intellij.modules.python</depends>
    <depends optional="true" config-file="call-graph-go.xml">org.jetbrains.plugins.go</depends>
    <!-- The JavaScript plugin covers both JavaScript and TypeScript. -->
    <depends optional="true" config-file="call-graph-javascript.xml">JavaScript</depends>
    <!-- Comparing with a named revision (the Changes "vs" field) uses Git; local changes vs HEAD work with any VCS. -->
    <depends optional="true" config-file="diff-git.xml">Git4Idea</depends>
    <extensionPoints>
        <extensionPoint qualifiedName="dev.insight.callGraphLanguageSupport"
                        interface="dev.insight.callgraph.CallGraphLanguageSupport" dynamic="true"/>
        <extensionPoint qualifiedName="dev.insight.diffBaseProvider"
                        interface="dev.insight.callgraph.DiffBaseProvider" dynamic="true"/>
        <extensionPoint qualifiedName="dev.insight.reviewDiffProvider"
                        interface="dev.insight.diff.ReviewDiffProvider" dynamic="true"/>
    </extensionPoints>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Prompt Constructor" anchor="right" icon="/icons/insight.svg"
                    factoryClass="dev.insight.prompts.PromptConstructorToolWindowFactory"/>
        <toolWindow id="Application Graph" anchor="right" icon="/icons/insight.svg"
                    factoryClass="dev.insight.callgraph.ProjectGraphToolWindowFactory"/>
        <toolWindow id="Insight Chat" anchor="right" icon="/icons/insight.svg"
                    factoryClass="dev.insight.chat.ChatToolWindowFactory"/>
        <toolWindow id="Diff Review" anchor="right" icon="/icons/insight.svg"
                    factoryClass="dev.insight.diff.DiffReviewToolWindowFactory"/>
        <toolWindow id="Code Review" anchor="right" icon="/icons/insight.svg"
                    factoryClass="dev.insight.codereview.CodeReviewToolWindowFactory"/>
        <!-- Raw request/response traffic of the LLM and Decisions APIs, for debugging. -->
        <toolWindow id="Insight API Logs" anchor="bottom" icon="/icons/insight.svg"
                    factoryClass="dev.insight.apilog.ApiLogToolWindowFactory"/>
        <applicationConfigurable parentId="tools" id="dev.insight.chat" displayName="Insight Chat"
                                 instance="dev.insight.chat.ChatSettingsConfigurable"/>
        <fileEditorProvider implementation="dev.insight.dashboard.DashboardEditorProvider"/>
        <fileEditorProvider implementation="dev.insight.diff.DiffReviewEditorProvider"/>
        <fileEditorProvider implementation="dev.insight.callgraph.CallGraphEditorProvider"/>
        <fileEditorProvider implementation="dev.insight.callgraph.SourceCallChainEditorProvider"/>
        <fileEditorProvider implementation="dev.insight.chat.SourcePointsEditorProvider"/>
    </extensions>
    <!-- The call graph uses Kotlin PSI references only, so it works with both the K1 and K2 Kotlin front ends. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
    <actions>
        <action id="Insight.OpenPromptConstructor" class="dev.insight.prompts.OpenPromptConstructorAction"
                text="Open Prompt Constructor" description="Assemble and edit prompts from a Markdown prompt and appendix library"
                icon="/icons/insight.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Insight.OpenDiffReview" class="dev.insight.diff.OpenDiffReviewAction"
                text="Open Diff Review" description="Review local changes, branches or commits with file and group notes"
                icon="/icons/insight.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Insight.OpenCodeReview" class="dev.insight.codereview.OpenCodeReviewAction"
                text="Open Code Review" description="Review the code in the project, a folder or an entry file with summaries, topics and notes"
                icon="/icons/insight.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Insight.ReviewDirectory" class="dev.insight.codereview.ReviewDirectoryAction"
                text="Review Code in Directory" description="Open Code Review for the code in this folder"
                icon="/icons/insight.svg">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>
        <action id="Insight.OpenDashboard" class="dev.insight.dashboard.OpenDashboardAction"
                text="Open Insight Dashboard" description="Open the Insight visualization workbench"
                icon="/icons/insight.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Insight.ShowCallGraph" class="dev.insight.callgraph.ShowCallGraphAction"
                text="Show Call Graph" description="Show the callers and callees of the function at the caret"
                icon="/icons/insight.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="StructureViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Insight.AddToFlowChart" class="dev.insight.callgraph.AddToFlowChartAction"
                text="Add to Flow Chart" description="Add the symbol at the caret to the flow chart of the Application Graph"
                icon="/icons/insight.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="StructureViewPopupMenu" anchor="last"/>
        </action>
        <action id="Insight.OpenSideBySide" class="dev.insight.callgraph.OpenSideBySideAction"
                text="Open Side by Side" description="Open the symbol at the caret side by side with its callers and the functions it calls"
                icon="/icons/insight.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="StructureViewPopupMenu" anchor="last"/>
        </action>
        <action id="Insight.ShowChanges" class="dev.insight.callgraph.ShowChangesInGraphAction"
                text="Show Changes in Application Graph"
                description="Highlight the symbols changed since HEAD and their callers and callees in the Application Graph"
                icon="/icons/insight.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
