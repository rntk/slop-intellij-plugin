<idea-plugin>
    <id>dev.insight.workbench</id>
    <name>Insight Workbench</name>
    <vendor>Insight Workbench</vendor>
    <description><![CDATA[
        A Kotlin workbench with a project chat sidebar and an editor-area visualization dashboard.
        The chat answers with a llama.cpp (or other OpenAI-compatible) server configured in Settings → Tools → Insight Chat,
        using read-only tools to list, search, and read project files; without a server it uses local demo responses.
        The dashboard shows explicitly labeled sample data.
        <br/>Application Graph shows Java, Kotlin, Python, Go, JavaScript and TypeScript project symbols and relationships, highlighting the active file.
        <br/>Show Call Graph (editor context menu, Tools menu) draws the callers and callees of a function in any of those languages.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <!-- Language support for the call graph is optional, so the plugin loads in any IDE and covers whichever languages it has. -->
    <depends optional="true" config-file="call-graph-java.xml">com.intellij.java</depends>
    <depends optional="true" config-file="call-graph-kotlin.xml">org.jetbrains.kotlin</depends>
    <!-- PyCharm (Community/Professional) and the Python plugins all provide the python module. -->
    <depends optional="true" config-file="call-graph-python.xml">com.intellij.modules.python</depends>
    <depends optional="true" config-file="call-graph-go.xml">org.jetbrains.plugins.go</depends>
    <!-- The JavaScript plugin covers both JavaScript and TypeScript. -->
    <depends optional="true" config-file="call-graph-javascript.xml">JavaScript</depends>
    <extensionPoints>
        <extensionPoint qualifiedName="dev.insight.callGraphLanguageSupport"
                        interface="dev.insight.callgraph.CallGraphLanguageSupport" dynamic="true"/>
    </extensionPoints>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Application Graph" anchor="right" icon="/icons/insight.svg"
                    factoryClass="dev.insight.callgraph.ProjectGraphToolWindowFactory"/>
        <toolWindow id="Insight Chat" anchor="right" icon="/icons/insight.svg"
                    factoryClass="dev.insight.chat.ChatToolWindowFactory"/>
        <applicationConfigurable parentId="tools" id="dev.insight.chat" displayName="Insight Chat"
                                 instance="dev.insight.chat.ChatSettingsConfigurable"/>
        <fileEditorProvider implementation="dev.insight.dashboard.DashboardEditorProvider"/>
        <fileEditorProvider implementation="dev.insight.callgraph.CallGraphEditorProvider"/>
        <fileEditorProvider implementation="dev.insight.callgraph.SourceCallChainEditorProvider"/>
    </extensions>
    <!-- The call graph uses Kotlin PSI references only, so it works with both the K1 and K2 Kotlin front ends. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
    <actions>
        <action id="Insight.OpenDashboard" class="dev.insight.dashboard.OpenDashboardAction"
                text="Open Insight Dashboard" description="Open the Insight visualization workbench"
                icon="/icons/insight.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Insight.ShowCallGraph" class="dev.insight.callgraph.ShowCallGraphAction"
                text="Show Call Graph" description="Show the callers and callees of the function at the caret"
                icon="/icons/insight.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="StructureViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
